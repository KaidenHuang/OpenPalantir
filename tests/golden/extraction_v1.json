{
  "version": 1,
  "description": "实体/关系抽取评测集：examples/docs 示例文档的人工标注。entities 为必须召回的金标（t 为可接受的 ObjectType key，命中任一算类型正确）；optional 为文档中确实存在、允许模型额外抽取但不要求召回的名称，用于把名称覆盖率算成 precision 侧指标。relations 的结构召回只看实体对（方向无关），p 列用于统计归一化后的谓词正确率。branch=table 的样例是表格文件：它们的图谱产出走 ④ 的纯规则装配（不经 LLM），sheets 段就是人工代标的 ③ 列标注（列角色/归一类型/主列/列间关系），规则用例据此逐行装配；正文样例仍按 LLM 分支评测。",
  "docs": [
    {
      "file": "examples/docs/组织架构说明.md",
      "domain": "workforce",
      "entities": [
        {"n": "平台工程部", "t": ["department", "organization"]},
        {"n": "数据平台组", "t": ["department", "organization"]},
        {"n": "工程效能组", "t": ["department", "organization"]},
        {"n": "王涛", "t": ["employee", "person"]},
        {"n": "张明", "t": ["employee", "person"]},
        {"n": "李芳", "t": ["employee", "person"]},
        {"n": "陈立", "t": ["employee", "person"]},
        {"n": "周雨", "t": ["employee", "person"]},
        {"n": "技术总监", "t": ["position", "concept"]}
      ],
      "optional": [
        "公司", "数据平台", "内部工具", "正式员工", "指标口径", "数据服务",
        "CI流水线", "发布工具", "调度系统", "作业稳定性", "研发度量",
        "职级评审", "人事系统", "技术序列", "评审结论", "职级", "组长",
        "L1", "L2", "L3", "L5"
      ],
      "relations": [
        {"s": "张明", "o": "数据平台组", "p": ["任职于", "属于"]},
        {"s": "李芳", "o": "工程效能组", "p": ["任职于", "属于"]},
        {"s": "陈立", "o": "数据平台组", "p": ["任职于", "属于"]},
