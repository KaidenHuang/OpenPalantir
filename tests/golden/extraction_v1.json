    {
      "file": "examples/docs/人员名册.xlsx",
      "domain": "workforce",
      "branch": "table",
      "sheets": [
        {
          "title": "员工",
          "columns": [
            {"n": "姓名", "r": "entity", "t": "employee", "d": "员工姓名", "primary": true},
            {"n": "部门", "r": "entity", "t": "department", "d": "员工所在部门", "primary": false},
            {"n": "职级", "r": "attribute", "d": "职级序列", "primary": false}
          ],
          "rels": [{"s": "姓名", "p": "任职于", "o": "部门"}]
        },
        {
          "title": "部门",
          "columns": [
            {"n": "部门", "r": "entity", "t": "department", "d": "部门名称", "primary": true},
            {"n": "上级部门", "r": "entity", "t": "department", "d": "该部门的上级", "primary": false}
          ],
          "rels": [{"s": "部门", "p": "属于", "o": "上级部门"}]
        }
      ],
      "entities": [
        {"n": "王涛", "t": ["employee"]},
        {"n": "张明", "t": ["employee"]},
        {"n": "平台工程部", "t": ["department"]},
        {"n": "数据平台组", "t": ["department"]},
        {"n": "工程效能组", "t": ["department"]}
      ],
      "optional": ["职级", "L5", "L3"],
      "relations": [
        {"s": "王涛", "o": "平台工程部", "p": ["任职于", "属于"]},
        {"s": "张明", "o": "数据平台组", "p": ["任职于", "属于"]},
        {"s": "数据平台组", "o": "平台工程部", "p": ["属于"]},
        {"s": "工程效能组", "o": "平台工程部", "p": ["属于"]}
      ]
    },
