        {"s": "数据平台组", "o": "平台工程部", "p": ["属于"]},
        {"s": "工程效能组", "o": "平台工程部", "p": ["属于"]},
        {"s": "张明", "o": "王涛", "p": ["受管理于", "管理"]},
        {"s": "周雨", "o": "王涛", "p": ["受管理于", "管理"]},
        {"s": "李芳", "o": "周雨", "p": ["受管理于", "管理"]},
        {"s": "陈立", "o": "张明", "p": ["受管理于", "管理"]}
      ]
    },
