# ===== Neo4j Configuration =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# ===== Redis Configuration =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== Application =====
APP_ENV=development
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:5175
BATCH_SIZE=100
CACHE_TTL=3600
# 设置后所有 /api 路由要求 X-API-Key 请求头（生产/局域网部署建议启用）
# API_AUTH_KEY=your-secret-key

# ===== 文档源监听（内容失效传播） =====
# DOC_WATCH_ENABLED=1 时后端启动轮询监听，比对摘要里的内容指纹，
# 自动为变更/已删除的文档派发刷新任务；默认关闭
DOC_WATCH_ENABLED=0
DOC_WATCH_INTERVAL=60

# ===== PDF 插图与扫描件 =====
# PDF 内嵌插图/图形落盘到 data/summaries/images/{source_id}/ 下，与摘要同根同键
# DOC_IMAGES_ENABLED=0 时完全跳过图片落盘（正文里不留图片引用）
DOC_IMAGES_ENABLED=1
# DOC_IMAGE_MODE=placeholder 只留图片占位；ocr 用 tesseract 抽出图内文字写进正文
DOC_IMAGE_MODE=placeholder
# tesseract 语言包；纯英文环境可改成 eng
DOC_OCR_LANG=chi_sim+eng

